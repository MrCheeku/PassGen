<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep local vault data and its local encryption key on the originating device. -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="passgen_vault_security.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- The vault database and key preferences must not be restored separately. -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="passgen_vault_security.xml" />
    </device-transfer>
</data-extraction-rules>
