<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Do not restore a local vault without its originating device's encryption key. -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="passgen_vault_security.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- The local vault and its local key must not be transferred separately. -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="passgen_vault_security.xml" />
    </device-transfer>
</data-extraction-rules>
